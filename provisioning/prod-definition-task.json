{
  "containerDefinitions": [
    {
      "name": "omnix-admin-ctn",
      "image": "709278514449.dkr.ecr.ap-southeast-1.amazonaws.com/yangtenggroup/omnix-admin:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "stopTimeout": 30,
      "secrets": [],
      "environment": [],
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-create-group": "true",
          "awslogs-group": "/prod-omnix/ecs/omnix-admin",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "prod-omnix-cluster"
        }
      }
    }
  ],
  "family": "prod-omnix-admin-task",
  "taskRoleArn": "arn:aws:iam::709278514449:role/ecs-task-role",
  "executionRoleArn": "arn:aws:iam::709278514449:role/ecs-task-execution-role",
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "requiresCompatibilities": ["FARGATE"]
}
