# 环境变量由 script/load-env.ts 加载（.umirc.ts 启动时执行），不依赖 Umi 内置 dotenv。
# 加载顺序（后者覆盖前者）：.env → .env.${UMI_ENV} → .env.local → .env.${UMI_ENV}.local
# 变量名必须以 UMI_APP_ 开头，才会注入到前端 bundle（通过 define）。

# Local dev（UMI_ENV=dev，npm run dev:local）
# UMI_APP_API_BASE_URL=/api
# UMI_APP_OMNIX_CHAT_DSN=your-dsn
# UMI_APP_OMNIX_CHAT_BASE_URL=/api

# Test 联调（UMI_ENV=test，npm run dev / build:test）
# UMI_APP_API_BASE_URL=https://omnix.cht-group.net
# UMI_APP_OMNIX_CHAT_DSN=your-dsn
# UMI_APP_OMNIX_CHAT_BASE_URL=https://omnix.cht-group.net

# Production（UMI_ENV=prod，npm run build:prod）
# UMI_APP_API_BASE_URL=https://api.your-domain.com
# UMI_APP_OMNIX_CHAT_BASE_URL=https://api.your-domain.com
